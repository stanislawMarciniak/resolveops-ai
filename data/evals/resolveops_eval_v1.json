  "cases": [
    {
      "eval_id": "acme-01",
      "customer_id": "ACME",
      "description": "ACME says its account is suspended even though invoice INV-8231 was paid. Investigate the real cause and propose the minimum safe remediation.",
      "tags": [
        "payment-matching",
        "identifier-normalization",
        "canonical"
      ],
      "ground_truth": {
        "expected_final_stage": "AWAITING_APPROVAL",
        "root_cause_keyword_groups": [
          ["TX-9912"],
          ["INV-8231", "INV8231"],
          ["unmatched", "not matched", "matching"],
          ["hold", "suspended", "suspension"]
        ],
        "expected_actions": [
          "match_payment",
          "remove_account_hold"
        ],
        "expected_customer_id": "ACME",
        "expected_review_verdict": "APPROVE",
        "expected_requires_approval": true
      }
    },
